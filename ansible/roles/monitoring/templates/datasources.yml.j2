---
apiVersion: 1
prune: true

datasources:
  - name: {{ grafana_prometheus_datasource_name | to_json }}
    uid: {{ grafana_prometheus_datasource_uid | to_json }}
    type: prometheus
    access: proxy
    url: {{ grafana_prometheus_url | to_json }}
    orgId: 1
    isDefault: true
    editable: false
    version: 1
    jsonData:
      httpMethod: POST
      timeInterval: {{ prometheus_scrape_interval | to_json }}

  - name: {{ grafana_loki_datasource_name | to_json }}
    uid: {{ grafana_loki_datasource_uid | to_json }}
    type: loki
    access: proxy
    url: {{ grafana_loki_url | to_json }}
    orgId: 1
    isDefault: false
    editable: false
    version: 1
