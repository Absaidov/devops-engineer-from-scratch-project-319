---
apiVersion: 1

providers:
  - name: {{ grafana_dashboard_provider_name | to_json }}
    orgId: 1
    folder: {{ grafana_dashboard_folder | to_json }}
    type: file
    disableDeletion: false
    editable: false
    updateIntervalSeconds: {{ grafana_dashboards_update_interval }}
    allowUiUpdates: false
    options:
      path: {{ grafana_dashboards_container_dir | to_json }}
      foldersFromFilesStructure: false
