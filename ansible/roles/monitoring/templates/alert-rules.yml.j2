---
apiVersion: 1

groups:
  - orgId: 1
    name: {{ grafana_alert_rule_group | to_json }}
    folder: {{ grafana_alert_folder | to_json }}
    interval: {{ grafana_alert_evaluation_interval }}
    rules:
{% for rule in grafana_alert_rules %}
      - uid: {{ rule.uid | to_json }}
        title: {{ rule.title | to_json }}
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: {{ grafana_prometheus_datasource_uid | to_json }}
            model:
              datasource:
                type: prometheus
                uid: {{ grafana_prometheus_datasource_uid | to_json }}
              editorMode: code
              expr: {{ rule.expression | to_json }}
              instant: true
              intervalMs: 15000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params: []
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - B
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              reducer: last
              refId: B
              type: reduce
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ rule.threshold }}
                    type: {{ rule.evaluator | to_json }}
                  operator:
                    type: and
                  query:
                    params:
                      - C
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              intervalMs: 1000
              maxDataPoints: 43200
              refId: C
              type: threshold
        dashboardUid: {{ rule.dashboard_uid | to_json }}
        panelId: {{ rule.panel_id }}
        noDataState: {{ rule.no_data_state }}
        execErrState: Alerting
        for: {{ rule.pending_for }}
        annotations:
          __dashboardUid__: {{ rule.dashboard_uid | to_json }}
          __panelId__: {{ rule.panel_id | string | to_json }}
          summary: {{ rule.summary | to_json }}
          description: {{ rule.description | to_json }}
        labels:
          service: {{ rule.service | to_json }}
          severity: {{ rule.severity | to_json }}
        isPaused: false
{% endfor %}
      - uid: manual_test_alert
        title: Manual notification test
        condition: A
        data:
          - refId: A
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - 0
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: {{ (grafana_test_alert_enabled | bool) | ternary('1 == 1', '1 == 0') | to_json }}
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
              type: math
        dashboardUid: status-page
        panelId: 8
        noDataState: OK
        execErrState: Error
        for: 0s
        annotations:
          __dashboardUid__: status-page
          __panelId__: "8"
          summary: Manual Grafana notification test
          description: >-
            Synthetic alert enabled by make grafana-alert-test. Reset it after
            the notification and screenshot are confirmed.
        labels:
          service: alerting
          severity: info
        isPaused: false
